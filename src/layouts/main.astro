---
import "@/styles/global.css"
import { getCollection } from "astro:content"
import { ClientRouter } from "astro:transitions"
import { ArticleNavigation } from "@/components/article-navigation"
import { BlogSearch } from "@/components/blog-search"

type ArticleHeading = {
  depth: number
  slug: string
  text: string
}

interface Props {
  title?: string
  description?: string
  articleNavigation?: {
    title: string
    headings: ArticleHeading[]
  }
}

const {
  title = "Blog",
  description = "Ideas y notas publicadas en Markdown.",
  articleNavigation,
} = Astro.props
const pageTitle = title === "Blog" ? title : `${title} — Blog`
const posts = await getCollection("blog")
const searchablePosts = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  category: post.id.includes("/") ? post.id.split("/")[0] : "general",
  href: `/blog/${post.id}/`,
}))
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <main class="pb-20">
      <slot />
    </main>
    <aside
      aria-label="Navegación del blog"
      class="pointer-events-none fixed inset-x-0 bottom-0 flex items-end justify-end gap-2 p-4 sm:p-6 xl:grid xl:grid-cols-[minmax(0,1fr)_minmax(0,48rem)_minmax(0,1fr)] xl:gap-0 xl:p-0"
    >
      {
        articleNavigation && (
          <div class="pointer-events-auto min-w-0 xl:col-start-1 xl:max-w-full xl:overflow-hidden xl:p-6">
            <ArticleNavigation
              title={articleNavigation.title}
              headings={articleNavigation.headings}
              client:load
            />
          </div>
        )
      }
      <div
        class="pointer-events-auto xl:col-start-3 xl:justify-self-end xl:p-6"
      >
        <BlogSearch posts={searchablePosts} client:load />
      </div>
    </aside>
  </body>
</html>
