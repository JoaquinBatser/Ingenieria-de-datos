---
import "@/styles/global.css"
import { getCollection } from "astro:content"
import { ClientRouter } from "astro:transitions"
import { BlogNavigation } from "@/components/blog-navigation"
import { getArticleCategory } from "@/lib/article-categories"
import {
  getArticleDisplayTitle,
  getArticleHref,
  getPublishedArticles,
} from "@/lib/article-variants"

type ArticleHeading = {
  depth: number
  slug: string
  text: string
}

interface Props {
  title?: string
  description?: string
  articleNavigation?: {
    href: string
    title: string
    category: {
      href: string
      label: string
    }
    headings: ArticleHeading[]
  }
}

const {
  title = "Blog",
  description = "Ideas y notas publicadas en Markdown.",
  articleNavigation,
} = Astro.props
const pageTitle = title === "Blog" ? title : `${title} — Blog`
const posts = await getCollection("blog")
const searchablePosts = getPublishedArticles(posts).map((post) => ({
  title: getArticleDisplayTitle(post),
  description: post.data.description,
  category: getArticleCategory(post.id).label,
  href: getArticleHref(post),
}))
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <BlogNavigation
      article={articleNavigation}
      posts={searchablePosts}
      client:load
    />
    <main class="pb-20 md:pb-0">
      <slot />
    </main>
  </body>
</html>
