---
import Layout from "@/layouts/main.astro"
import { Kbd } from "@/components/ui/kbd"
import { getArticleCategory } from "@/lib/article-categories"
import {
  getArticleDisplayTitle,
  getArticleHref,
  getArticleRouteId,
  getPublishedArticles,
  validateArticleRoutes,
} from "@/lib/article-variants"
import { getCollection } from "astro:content"

const getPostOrder = (id: string) => {
  const filename = id.split("/").at(-1)
  const match = filename?.match(/^(\d+)/)

  return match ? Number(match[1]) : Number.MAX_SAFE_INTEGER
}

const postsByFolder = new Map<
  string,
  Awaited<ReturnType<typeof getCollection<"blog">>>
>()

const allPosts = await getCollection("blog")
validateArticleRoutes(allPosts)

for (const post of getPublishedArticles(allPosts)) {
  const folder = getArticleCategory(post.id).slug
  const folderPosts = postsByFolder.get(folder) ?? []

  folderPosts.push(post)
  postsByFolder.set(folder, folderPosts)
}

const groups = Array.from(postsByFolder, ([folder, posts]) => ({
  folder,
  label: getArticleCategory(folder).label,
  order: Math.min(...posts.map((post) => getPostOrder(post.id))),
  posts: posts.sort(
    (a, b) =>
      getPostOrder(a.id) - getPostOrder(b.id) ||
      a.data.title.localeCompare(b.data.title, "es")
  ),
})).sort((a, b) => a.order - b.order || a.label.localeCompare(b.label, "es"))
---

<Layout>
  <section class="mx-auto flex max-w-3xl flex-col gap-8 p-6">
    <header class="flex flex-col gap-2">
      <h1 class="font-medium">Posts</h1>
      <p>
        Notas publicadas en Markdown. Usa <Kbd>⌘K</Kbd> para buscar.
      </p>
    </header>

    <div class="flex flex-col gap-10">
      {
        groups.map((group) => (
          <section id={group.folder} class="scroll-mt-20 flex flex-col gap-4">
            <h2 class="font-medium">{group.label}</h2>
            <ul class="flex flex-col gap-6">
              {group.posts.map((post) => (
                <li>
                  <article class="flex flex-col gap-1">
                    <h3
                      transition:name={`article-title-${getArticleRouteId(post).replaceAll("/", "-")}`}
                      class="font-medium"
                    >
                      <a
                        href={getArticleHref(post)}
                        data-astro-prefetch="hover"
                      >
                        {getArticleDisplayTitle(post)}
                      </a>
                    </h3>
                    <p>{post.data.description}</p>
                  </article>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Layout>
