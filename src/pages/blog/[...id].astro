---
import type { CollectionEntry } from "astro:content"
import { getCollection, render } from "astro:content"

import CodeBlock from "@/components/code-block.astro"
import { getArticleCategory } from "@/lib/article-categories"
import {
  getArticleDisplayTitle,
  getArticleHref,
  getArticleRouteId,
  getPublishedArticles,
  validateArticleRoutes,
} from "@/lib/article-variants"
import Layout from "@/layouts/main.astro"

export async function getStaticPaths() {
  const posts = await getCollection("blog")
  validateArticleRoutes(posts)

  return getPublishedArticles(posts).map((post) => ({
    params: { id: getArticleRouteId(post) },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<"blog">
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const articleTransitionName = `article-title-${getArticleRouteId(post).replaceAll("/", "-")}`
const displayTitle = getArticleDisplayTitle(post)
const category = getArticleCategory(post.id)
---

<Layout
  title={displayTitle}
  description={post.data.description}
  articleNavigation={{
    href: getArticleHref(post),
    title: displayTitle,
    category,
    headings,
  }}
>
  <article class="mx-auto flex max-w-3xl flex-col gap-8 p-6">
    <div
      class="article-content typeset typeset-docs max-w-[37em]"
      style={`--article-title-transition: ${articleTransitionName}`}
    >
      <Content components={{ pre: CodeBlock }} />
    </div>
  </article>
</Layout>
